# Dependencias (se instalan con `npm install`)
node_modules/

# Salidas de compilación (se generan con `npm run dist`)
dist/
build/*.ico
build/.icon-ico/

# No se ignora la app portable de la raíz (tbnllm.exe y sus DLLs/pak/etc):
# se sube igual, vía Git LFS (ver .gitattributes) para no chocar con el
# límite de 100 MB de GitHub en un commit normal.
/tbnllm-portable*.zip

# Logs y basura del SO
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
